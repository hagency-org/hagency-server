# Copy to acceptance/gitfab.env (not committed) or point GITFAB_CONFIG at it. No secrets here: only the
# paths of credential files, each mode 0600.
GITFAB_SERVER_URL=https://hagency.example.org
GITFAB_MATRIX_URL=https://hagency.example.org
GITFAB_REGISTRY_URL=
GITFAB_GITHUB_API=https://api.github.com
GITFAB_GITCODE_API=https://api.gitcode.com/api/v5
GITFAB_GITHUB_TOKEN_FILE=~/.config/gitfab/github-token
GITFAB_GITCODE_TOKEN_FILE=~/.config/gitfab/gitcode-token
# run-project.sh: the acceptance Human's Matrix access token and Hagency session, each mode 0600.
GITFAB_MATRIX_TOKEN_FILE=~/.config/gitfab/matrix-token
GITFAB_SESSION_TOKEN_FILE=~/.config/gitfab/hagency-session
# 1 confirms the Spec from the script; otherwise the Human confirms it in the Thread (/gitfab approve).
GITFAB_AUTO_APPROVE_SPEC=
# Deployment (verify-release.sh, rollback.sh): the Runner's receipt journal and SBOM directory, and for
# rollback its key (mode 0600), key id and Runner id. Its public key goes into GITFAB_KEYS_DIR.
GITFAB_RECEIPTS=
GITFAB_SBOM_DIR=
GITFAB_RUNNER_KEY_FILE=
GITFAB_RUNNER_KEY_ID=
GITFAB_RUNNER_ID=
# The server's [gitfab] journal_file, or an exported copy of it.
GITFAB_JOURNAL=
# Defaults: acceptance/keys (public keys pinned at T0) and ./evidence.
GITFAB_KEYS_DIR=
GITFAB_EVIDENCE_DIR=
