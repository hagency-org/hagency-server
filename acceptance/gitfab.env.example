# Copy to acceptance/gitfab.env (not committed) or point GITFAB_CONFIG at it. No secrets here: only the
# paths of credential files, each mode 0600.
GITFAB_SERVER_URL=https://hagency.example.org
GITFAB_MATRIX_URL=https://hagency.example.org
GITFAB_REGISTRY_URL=
GITFAB_GITHUB_API=https://api.github.com
GITFAB_GITCODE_API=https://api.gitcode.com/api/v5
GITFAB_GITHUB_TOKEN_FILE=~/.config/gitfab/github-token
GITFAB_GITCODE_TOKEN_FILE=~/.config/gitfab/gitcode-token
# The server's [gitfab] journal_file, or an exported copy of it.
GITFAB_JOURNAL=
# Defaults: acceptance/keys (public keys pinned at T0) and ./evidence.
GITFAB_KEYS_DIR=
GITFAB_EVIDENCE_DIR=
