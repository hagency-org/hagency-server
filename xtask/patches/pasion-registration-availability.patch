+
+/* A complete account-access state when no registration method is available. */
+.registration-closed .login-title {
+    margin: 0;
+}
+.registration-unavailable-description {
+    color: var(--color-text-secondary);
+    line-height: 1.6;
+    text-align: center;
+    margin: 0 0 24px;
+}
+.registration-unavailable-help {
+    padding: 16px;
+    margin: 0;
+    border: 1px solid var(--color-border);
+    border-radius: 12px;
+    background: var(--color-bg-secondary);
+    color: var(--color-text-secondary);
+    line-height: 1.6;
+    overflow-wrap: anywhere;
+}
+.registration-unavailable-help p {
+    margin: 0;
+}
+.registration-unavailable-help p + p {
+    margin-top: 12px;
+}
