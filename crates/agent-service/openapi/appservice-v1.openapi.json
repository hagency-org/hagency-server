{
  "openapi": "3.1.0",
  "info": {
    "title": "Hagency Matrix appservice receiver",
    "version": "1.0.0",
    "description": "Mandatory installed AS homeserver→Hagency interface. Authenticate with registration hs_token, never as_token or owner session/device token. Exact Bearer header or access_token query; if both present they must match; duplicate Authorization or duplicate query token rejected. Header preferred to avoid URL token logging. Matrix errors {errcode,error}: auth 403 M_FORBIDDEN, invalid 400 M_BAD_JSON, missing 404 M_NOT_FOUND, remaining M_UNKNOWN. AS acknowledgement is durable ingest; untrusted event contents are not authorization facts."
  },
  "paths": {
    "/_matrix/app/v1/transactions/{transaction_id}": {
      "put": {
        "operationId": "acceptTransaction",
        "description": "Commit canonical transaction digest, raw inbox and routing intent atomically before ACK. Same ID+same canonical content is idempotent; changed content conflicts. Durable ACK does not mean model execution or reply completion. Payload ≤2 MiB; pending queue defaults 10000 and 16 MiB; queue full returns 503 without ACK.",
        "security": [
          {
            "homeserverBearer": []
          },
          {
            "homeserverQueryToken": []
          }
        ],
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Empty"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatrixError"
                }
              }
            }
          },
          "403": {
            "description": "Wrong or missing homeserver token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatrixError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown user or Room alias",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatrixError"
                }
              }
            }
          },
          "409": {
            "description": "Transaction content mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatrixError"
                }
              }
            }
          },
          "503": {
            "description": "Storage or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatrixError"
                }
              }
            }
          },
          "413": {
            "description": "Size limiter rejection; framework-defined body."
          }
        },
        "x-source": {
          "file": "crates/agent-service/src/appservice.rs",
          "anchors": [
            "Router::with_path(\"transactions/{transaction_id}\")",
            ".put(self.clone())"
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Transaction"
              }
            }
          }
        }
      }
    },
